{
  "name": "@meru-mind/core",
  "version": "0.5.4",
  "description": "Scoped visibility (MindRealm) and layered memory & ledger engine (MindSea) for multi-agent teams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Matthewoho/meru-mind.git"
  },
  "homepage": "https://github.com/Matthewoho/meru-mind#readme",
  "bugs": {
    "url": "https://github.com/Matthewoho/meru-mind/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-memory",
    "mcp",
    "sqlite",
    "fts5",
    "sqlite-vec",
    "multi-agent",
    "ledger"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "meru-mind": "./dist/cli.js",
    "meru-mind-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "deploy",
    "README.md",
    "README.zh-CN.md",
    "ARCHITECTURE.md",
    "THREAT_MODEL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/copy-vendor.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "check:oss": "node scripts/check-oss.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "marked": "18.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
