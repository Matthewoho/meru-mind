# Runtime data home (must be outside the source repository)
MERU_MIND_HOME=~/.meru-mind

# Drive adapter: local | layerfs
MERU_MIND_DRIVE=local

# Optional: LayerFS SDK path if using MERU_MIND_DRIVE=layerfs
# LAYERFS_SDK_DIR=

# Optional: OpenAI-compatible embedding endpoint for sqlite-vec hybrid recall
# MERU_MIND_EMBED_URL=https://api.openai.com/v1
# MERU_MIND_EMBED_API_KEY=
# MERU_MIND_EMBED_MODEL=text-embedding-3-small
# MERU_MIND_EMBED_DIM=1536
